{
    "timer": {
        "default_duration": 300,
        "mode": "countdown",
        "show_warning": true,
        "warning_threshold": 120,
        "color_scheme": "gradient",
        "font_size": 72,
        "show_seconds": true
    },
    "media": {
        "auto_play": false,
        "auto_advance": false,
        "fullscreen_on_play": false,
        "default_transition": "fade",
        "maintain_aspect_ratio": true,
        "supported_formats": [
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".mp4",
            ".avi",
            ".mov"
        ]
    },
    "face_ai": {
        "enabled": true,
        "camera_index": 0,
        "sampling_frequency": 2,
        "attention_threshold": 0.5,
        "enable_emotion_detection": true,
        "enable_gaze_tracking": true,
        "chart_type": "pie"
    },
    "display": {
        "mode": "mirror",
        "auto_detect": true,
        "target_resolution": {
            "width": 1920,
            "height": 1080
        }
    },
    "sound": {
        "warning_enabled": true,
        "warning_volume": 96,
        "custom_warning_sound": "assets/warning_beep.wav",
        "finished_enabled": true,
        "finished_volume": 80,
        "custom_finished_sound": "assets/finished_beep.wav"
    },
    "general": {
        "language": "en",
        "theme": "dark",
        "font_size": 12,
        "high_contrast": true,
        "optimize_for_projector": true,
        "auto_save": true,
        "backup_interval": 300
    },
    "assets": {
        "logo_path": "",
        "branding_enabled": true,
        "custom_colors": {
            "primary": "#ffffff",
            "secondary": "#000000"
        }
    }
}
